# Server-side values only. This file contains no credentials.
HOST=127.0.0.1
PORT=4173
# Configure an actual mail transfer agent on the server before enabling forms.
SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_FROM=info@fcrae.ee
# Must be outside the website/app directory, readable only by the service user.
FORMS_DATABASE=/var/lib/fcrae/requests.sqlite
# Set only behind a localhost reverse proxy that overwrites X-Real-IP.
TRUST_LOCAL_PROXY=1
